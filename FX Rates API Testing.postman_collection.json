    {
      "name": "Get FX Rates - Invalid Currency",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"API result is error\", function () {\r\n    pm.expect(response.result).to.eql(\"error\");\r\n});\r\n\r\npm.test(\"Error type is unsupported-code\", function () {\r\n    pm.expect(response[\"error-type\"]).to.eql(\"unsupported-code\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v6/latest/XXX",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v6",
            "latest",
            "XXX"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get FX Rates - Data Driven (CSV)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\n\r\npm.test(\"Response base currency matches requested currency\", function () {\r\n    const requestedCurrency =\r\n        pm.iterationData.get(\"baseCurrency\") ||\r\n        pm.variables.get(\"baseCurrency\");\r\n\r\n    pm.expect(response.base_code).to.eql(requestedCurrency);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v6/latest/{{baseCurrency}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v6",
            "latest",
            "{{baseCurrency}}"
          ]
        }
      },
      "response": []
    }
